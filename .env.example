# Copy this file to .env and fill in your values

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# At least 32 bytes for HS256 JWT signing.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION_MINUTES=60

# Set to true when the AI service is enabled (e.g. Gemini profile)
AI_ENABLED=false
AI_SERVICE_TOKEN=change-me-to-a-long-random-service-token

GEMINI_API_KEY=your-gemini-api-key

# Bootstrap administrator created by user-service on startup.
# Leave empty to skip creating the bootstrap admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Login brute-force protection (per username)
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15

# Observability
JPA_SHOW_SQL=false
TRACING_ENABLED=false
TRACING_SAMPLING_PROBABILITY=0.1
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
