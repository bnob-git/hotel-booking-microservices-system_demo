# Copy this file to .env and fill in your values

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# At least 32 bytes for HS256 JWT signing.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION_MINUTES=60

# Set to true when the AI service is enabled (e.g. Gemini profile)
AI_ENABLED=false
AI_SERVICE_TOKEN=change-me-to-a-long-random-service-token

GEMINI_API_KEY=your-gemini-api-key

# Loyalty service (Track C)
LOYALTY_SERVICE_URL=http://loyalty-service:8086
LOYALTY_DB_NAME=loyalty_db
# Points earned per EUR of booking total (before tier multiplier)
LOYALTY_POINTS_PER_EURO=10
# EUR value of one point when redeeming (100 points = EUR 5)
LOYALTY_POINT_VALUE=0.05
# Points must be redeemed in multiples of this value
LOYALTY_REDEMPTION_INCREMENT=100

# Notification service (Track D). Mailpit catches all mail locally: UI at http://localhost:8025
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=Hotel Reservations <no-reply@hotel.local>
NOTIFICATION_DB_NAME=notification_db
# Base URL used for links in emails (e.g. /guest/lookup?code=...)
FRONTEND_BASE_URL=http://localhost:4200
