# Copy this file to .env and fill in your values

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# At least 32 bytes for HS256 JWT signing.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION_MINUTES=60

# Set to true when the AI service is enabled (e.g. Gemini profile)
AI_ENABLED=false
AI_SERVICE_TOKEN=change-me-to-a-long-random-service-token

# Shared secret for internal service-to-service calls, sent as the
# X-Internal-Token header (see docs/CONVENTIONS.md).
INTERNAL_SERVICE_TOKEN=change-me-to-a-long-random-internal-token

GEMINI_API_KEY=your-gemini-api-key
